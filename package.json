{
  "name": "flashmessage-js",
  "version": "2.0.0",
  "description": "A modern, lightweight, and fully customizable flash message library for React applications",
  "author": "adu-yeboah",
  "repository": {
    "type": "git",
    "url": "https://github.com/adu-yeboah/flash-message"
  },
  "homepage": "https://flashmessage-docs.vercel.app/",
  "keywords": [
    "flash-message",
    "react",
    "tailwind",
    "notifications",
    "toast",
    "notifications",
    "alerts",
    "snackbar",
    "message",
    "notification",
    "react-component",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "license": "MIT",
  "devDependencies": {
    "@tsdown/css": "^0.23.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.2.0",
    "jsdom": "^30.1.3",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
